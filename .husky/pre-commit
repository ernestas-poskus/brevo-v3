#!/bin/sh
set -e

echo "Running pre-commit checks..."

echo "1. Checking formatting..."
cargo fmt --all -- --check

echo "2. Checking compilation..."
CARGO_TARGET_DIR=target/check cargo check --all-targets --all-features

echo "3. Running Clippy lints..."
CARGO_TARGET_DIR=target/check cargo clippy --all-targets --all-features -- -D warnings

echo "4. Running tests..."
CARGO_TARGET_DIR=target/gemini cargo nextest run --all-features --status-level fail -p brevo-v3

echo "5. Checking documentation..."
RUSTDOCFLAGS="-D warnings" CARGO_TARGET_DIR=target/check cargo doc --no-deps --all-features

echo "All pre-commit checks passed successfully!"
